# URL pública do site. Alimenta canonical, Open Graph, JSON-LD, robots.txt e
# sitemap.xml — é o único lugar a mudar quando o domínio for definido.
VITE_SITE_URL=https://rabisco.pages.dev

# Subcaminho onde o site é servido, quando não é a raiz do domínio. O deploy
# do GitHub Pages define /Rabisco/; num domínio próprio, deixe vazio.
VITE_BASE=
